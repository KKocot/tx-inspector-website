---
interface Props {
  text: string;
  variant?: "default" | "primary" | "success" | "warning" | "posting" | "active" | "owner" | "neutral";
}

const { text, variant = "default" } = Astro.props;

const variantClasses: Record<string, string> = {
  default:
    "bg-white/5 text-text-muted border-border",
  primary:
    "bg-primary/10 text-primary border-primary/30",
  success:
    "bg-secondary/10 text-secondary border-secondary/30",
  warning:
    "bg-accent/10 text-accent border-accent/30",
  posting:
    "bg-[rgba(15,189,134,0.1)] text-secondary border-[rgba(15,189,134,0.3)]",
  active:
    "bg-[rgba(15,186,189,0.1)] text-primary border-[rgba(15,186,189,0.3)]",
  owner:
    "bg-[rgba(189,116,15,0.1)] text-accent border-[rgba(189,116,15,0.3)]",
  neutral:
    "bg-white/5 text-text-muted border-border",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5",
    "px-3 py-1",
    "rounded-full",
    "text-xs font-medium uppercase tracking-widest",
    "border",
    "backdrop-blur-sm",
    variantClasses[variant],
  ]}
>
  {text}
</span>
