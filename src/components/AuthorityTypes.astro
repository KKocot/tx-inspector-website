---
import SectionHeader from "./SectionHeader.astro";
import GlassCard from "./GlassCard.astro";
import Badge from "./Badge.astro";

const authorities = [
  {
    name: "Posting",
    color: "#0fbd86",
    colorAlpha: "rgba(15, 189, 134, 0.1)",
    badgeVariant: "posting" as const,
    tagText: "Most Common",
    description:
      "Social operations — voting, commenting, posting. The most commonly used authority level.",
    examples: ["Post / comment", "Upvote / downvote", "Reblog"],
    delay: 0,
  },
  {
    name: "Active",
    color: "#0fbabd",
    colorAlpha: "rgba(15, 186, 189, 0.1)",
    badgeVariant: "active" as const,
    tagText: "Financial",
    description:
      "Financial operations — transfers, market orders, witness voting. Controls your wallet.",
    examples: ["Transfers", "Power up / down", "Witness votes"],
    delay: 100,
  },
  {
    name: "Owner",
    color: "#bd740f",
    colorAlpha: "rgba(189, 116, 15, 0.1)",
    badgeVariant: "owner" as const,
    tagText: "Highest Level",
    description:
      "Account recovery and authority changes. The highest level — use with extreme caution.",
    examples: ["Change keys", "Account recovery"],
    delay: 200,
  },
];
---

<section
  id="authority-types"
  class="relative py-16 md:py-20 lg:py-24"
  aria-labelledby="authority-types-heading"
>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-6 md:px-8">
    <SectionHeader
      badge="AUTHORITY LEVELS"
      title="Understand the signing hierarchy"
      description="HIVE uses a three-tier authority system. Each transaction operation requires a specific authority level to execute."
      id="authority-types-heading"
    />

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      {authorities.map((auth) => (
        <div
          class="animate-on-scroll"
          data-animate="fade-left"
          data-delay={String(auth.delay)}
        >
          <GlassCard
            class={`authority-card h-full border-l-[3px]`}
            style={`border-left-color: ${auth.color};`}
          >
            <!-- Icon container -->
            <div
              class="flex h-10 w-10 items-center justify-center rounded-lg"
              style={`background: ${auth.colorAlpha};`}
            >
              {auth.name === "Posting" && (
                /* Pencil / edit icon */
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  style={`color: ${auth.color};`}
                >
                  <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                  <path d="m15 5 4 4" />
                </svg>
              )}
              {auth.name === "Active" && (
                /* Zap / bolt icon */
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  style={`color: ${auth.color};`}
                >
                  <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
                </svg>
              )}
              {auth.name === "Owner" && (
                /* Crown icon */
                <svg
                  class="h-5 w-5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  style={`color: ${auth.color};`}
                >
                  <path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z" />
                  <path d="M5 21h14" />
                </svg>
              )}
            </div>

            <!-- Badge -->
            <div class="mt-4">
              <Badge text={auth.tagText} variant={auth.badgeVariant} />
            </div>

            <!-- Title -->
            <h3 class="mt-3 text-lg font-semibold tracking-[-0.01em] text-text lg:text-2xl">
              {auth.name} Authority
            </h3>

            <!-- Description -->
            <p class="mt-2 text-sm leading-relaxed text-text-muted lg:text-base">
              {auth.description}
            </p>

            <!-- Examples pills -->
            <div class="mt-4 flex flex-wrap gap-2">
              {auth.examples.map((example) => (
                <span class="rounded-full bg-surface-light px-3 py-1 text-xs font-medium text-text-dim lg:text-sm">
                  {example}
                </span>
              ))}
            </div>
          </GlassCard>
        </div>
      ))}
    </div>

    <!-- Note below cards -->
    <p
      class="animate-on-scroll mx-auto mt-8 max-w-[720px] text-center text-sm leading-relaxed text-text-dim md:mt-10"
      data-animate="fade-up"
      data-delay="300"
    >
      The Transaction Inspector automatically detects which authority level each operation requires and verifies the corresponding signatures.
    </p>
  </div>
</section>

<style>
  /* Authority card — border-left glow on hover */
  .authority-card {
    transition:
      border-color 250ms ease-out,
      box-shadow 250ms ease-out;
  }

  .authority-card:hover {
    transform: none;
  }

  /* fade-left animation keyframe (supplement to global.css) */
  @keyframes scroll-fade-left {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Override for fade-left animated elements */
  :global(.animate-on-scroll[data-animate="fade-left"]) {
    opacity: 0;
    transform: translateX(-12px);
  }

  :global(.animate-on-scroll[data-animate="fade-left"].is-visible) {
    animation: scroll-fade-left 500ms ease-out forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-on-scroll[data-animate="fade-left"]) {
      opacity: 1;
      transform: none;
    }

    :global(.animate-on-scroll[data-animate="fade-left"].is-visible) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
