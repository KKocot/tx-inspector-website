---
const features = [
  {
    title: "Signature Verification",
    description:
      "Verify transaction signatures against public keys. Instantly confirm cryptographic validity and detect tampering.",
    prefix: "01",
    prefixColor: "text-[#0fbabd]",
    hoverColor: "hover:text-[#3dd6d9]",
    delay: 0,
  },
  {
    title: "Authority Path Tracing",
    description:
      "Trace the complete authority chain — direct signing or delegated authority paths visualized as an interactive graph.",
    prefix: "02",
    prefixColor: "text-[#0fbd86]",
    hoverColor: "hover:text-[#4ebf71]",
    delay: 80,
  },
  {
    title: "Operations Breakdown",
    description:
      "See every operation in the transaction with required authority levels, color-coded by type: posting, active, or owner.",
    prefix: "03",
    prefixColor: "text-[#bd740f]",
    hoverColor: "hover:text-[#d4922e]",
    delay: 160,
  },
];
---

<section
  id="features"
  class="relative min-h-screen flex flex-col items-center justify-center py-16 md:py-20 lg:py-24"
  aria-labelledby="features-heading"
>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-6 md:px-8">
    <div class="mb-12 lg:mb-16">
      <h2
        id="features-heading"
        class="animate-on-scroll text-[1.75rem] font-bold leading-[1.2] tracking-[-0.02em] text-text sm:text-[2rem] lg:text-[2.5rem]"
        data-animate="fade-up"
        data-delay="0"
      >
        Everything you need to analyze transactions
      </h2>

      <p
        class="animate-on-scroll mt-4 max-w-[640px] text-base leading-relaxed text-text-muted lg:text-xl"
        data-animate="fade-up"
        data-delay="50"
      >
        From signature verification to authority tracing, Transaction Inspector gives you complete visibility into HIVE blockchain operations.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-0 md:grid-cols-3">
      {features.map((feature, index) => (
        <div
          class:list={[
            "animate-on-scroll feature-item",
            index < features.length - 1 ? "border-b border-border-subtle md:border-b-0" : "",
          ]}
          data-animate="fade-up"
          data-delay={String(feature.delay)}
        >
          <div class="py-6 md:py-8">
            <span
              class:list={[
                "font-mono text-sm",
                feature.prefixColor,
              ]}
            >
              {feature.prefix}
            </span>

            <h3
              class:list={[
                "feature-title mt-3 text-lg font-semibold tracking-[-0.01em] text-text",
                feature.hoverColor,
              ]}
            >
              {feature.title}
            </h3>

            <p class="mt-2 max-w-[480px] text-sm leading-relaxed text-text-muted">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-item {
    transition: none;
  }

  .feature-title {
    transition: color var(--duration-fast) var(--ease-out-quad);
  }

  /* 3-col grid separators on md+ */
  @media (min-width: 768px) {
    /* Vertical separators between columns 1-2 and 2-3 */
    .feature-item:nth-child(1),
    .feature-item:nth-child(2) {
      border-right: 1px solid var(--color-border-subtle);
    }

    /* Padding: first gets pr, middle gets px, last gets pl */
    .feature-item:nth-child(1) {
      padding-right: 2rem;
    }

    .feature-item:nth-child(2) {
      padding-inline: 2rem;
    }

    .feature-item:nth-child(3) {
      padding-left: 2rem;
    }
  }
</style>
