---
/**
 * Nav — Sticky glassmorphism navigation bar.
 *
 * Features:
 * - Glassmorphism backdrop (blur + semi-transparent bg)
 * - Logo with inline SVG hexagon icon + wordmark
 * - "Launch App" CTA button
 * - Mobile: CSS-only hamburger via <details> (no JS framework)
 * - Smooth-scroll nav links (Features, How it Works, Formats)
 */

import { GITLAB_URL, HIVE_BRIDGE_URL } from "../config";

const gitlabUrl = GITLAB_URL;
const hiveBridgeUrl = HIVE_BRIDGE_URL;
---

<header
  class="fixed top-0 left-0 right-0 z-50 h-16 border-b border-white/5 bg-black/60 backdrop-blur-xl backdrop-saturate-150"
  role="banner"
>
  <nav
    class="mx-auto flex h-full max-w-[1200px] items-center justify-between px-5 sm:px-6 md:px-8"
    aria-label="Main navigation"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="Transaction Inspector — Home">
      <!-- Hexagon icon -->
      <svg
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="shrink-0"
      >
        <path
          d="M14 2L25.26 8.5V21.5L14 28L2.74 21.5V8.5L14 2Z"
          stroke="var(--color-primary)"
          stroke-width="1.5"
          fill="none"
        />
        <!-- Magnifying glass inside hexagon -->
        <circle
          cx="12.5"
          cy="12.5"
          r="4"
          stroke="var(--color-primary)"
          stroke-width="1.5"
          fill="none"
        />
        <line
          x1="15.5"
          y1="15.5"
          x2="19"
          y2="19"
          stroke="var(--color-primary)"
          stroke-width="1.5"
          stroke-linecap="round"
        />
      </svg>

      <!-- Wordmark: full on sm+, abbreviated below -->
      <span class="hidden text-base font-semibold tracking-tight text-[var(--color-text)] sm:inline">
        Transaction Inspector
      </span>
      <span class="inline text-base font-semibold tracking-tight text-[var(--color-text)] sm:hidden">
        TX Inspector
      </span>
    </a>

    <!-- Desktop nav links (hidden on mobile) -->
    <ul class="hidden items-center gap-6 md:flex" role="list">
      <li>
        <a
          href="#features"
          class="text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]"
        >
          Features
        </a>
      </li>
      <li>
        <a
          href="#details"
          class="text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]"
        >
          Details
        </a>
      </li>
      <li>
        <a
          href="#footer-cta"
          class="text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-text)]"
        >
          Open Source
        </a>
      </li>
    </ul>

    <!-- Right side: icon links + CTA + mobile menu -->
    <div class="flex items-center gap-3">
      <!-- GitLab icon link (desktop only) -->
      <a
        href={gitlabUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitLab"
        title="GitLab Repository"
        class="hidden text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-primary)] md:inline-flex"
      >
        <svg width="24" height="24" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 30.4L21.3 14.1H10.7L16 30.4Z"/><path d="M16 30.4L10.7 14.1H2.4L16 30.4Z" opacity="0.7"/><path d="M2.4 14.1L0.5 20.1C0.3 20.7 0.5 21.4 1 21.8L16 30.4L2.4 14.1Z" opacity="0.5"/><path d="M2.4 14.1H10.7L7.4 3.9C7.2 3.3 6.4 3.3 6.2 3.9L2.4 14.1Z"/><path d="M16 30.4L21.3 14.1H29.6L16 30.4Z" opacity="0.7"/><path d="M29.6 14.1L31.5 20.1C31.7 20.7 31.5 21.4 31 21.8L16 30.4L29.6 14.1Z" opacity="0.5"/><path d="M29.6 14.1H21.3L24.6 3.9C24.8 3.3 25.6 3.3 25.8 3.9L29.6 14.1Z"/></svg>
      </a>

      <!-- Hive Bridge icon link (desktop only) -->
      <a
        href={hiveBridgeUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Hive Bridge"
        title="Hive Bridge (Auth)"
        class="hidden text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:text-[var(--color-primary)] md:inline-flex"
      >
        <svg
          width="24"
          height="24"
          viewBox="0 0 220 190"
          fill="currentColor"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M157.272625,107.263942 C157.998992,107.263942 158.45262,108.051463 158.088736,108.68075 L111.33839,189.528945 C111.169808,189.820485 110.858795,190 110.522279,190 L81.9443812,190 C81.2180145,190 80.764386,189.212478 81.1282705,188.583191 L127.878616,107.734996 C128.047199,107.443456 128.358211,107.263942 128.694727,107.263942 L157.272625,107.263942 Z M129.477721,84.0901367 C129.141205,84.0901367 128.830192,83.9106218 128.66161,83.6190818 L81.1282705,1.41680884 C80.764386,0.787521511 81.2180145,0 81.9443812,0 L110.522279,0 C110.858795,0 111.169808,0.179514873 111.33839,0.471054898 L158.87173,82.6733278 C159.235614,83.3026152 158.781986,84.0901367 158.055619,84.0901367 L129.477721,84.0901367 Z" />
          <path d="M135.128406 1.41635199C134.76385.787064228 135.218932 0 135.947343 0L164.565951 0C164.903712 0 165.215845.179714185 165.384888.47151174L219.873006 94.5275799C220.042331 94.8198642 220.042331 95.1801358 219.873006 95.4724201L165.384888 189.528488C165.215845 189.820286 164.903712 190 164.565951 190L135.947343 190C135.218932 190 134.76385 189.212936 135.128406 188.583648L189.342845 95 135.128406 1.41635199zM111.870216 94.5240823C112.042446 94.816752 112.043313 95.1785591 111.872487 95.4720377L57.1252257 189.528106C56.7599958 190.155572 55.8478414 190.157723 55.4796094 189.531986L.129783614 95.4759177C-.0424457704 95.183248-.0433125021 94.8214409.127512727 94.5279623L54.8747743.471894257C55.2400042-.15557243 56.1521586-.157723129 56.5203906.468014185L111.870216 94.5240823z" />
        </svg>
      </a>

      <!-- Mobile hamburger menu (CSS-only via details/summary) -->
      <details class="relative md:hidden" id="mobile-menu">
        <summary
          class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-lg border border-[var(--color-border)] bg-transparent text-[var(--color-text-muted)] transition-colors duration-200 ease-out list-none hover:border-[var(--color-border-hover)] hover:bg-[var(--color-surface-light)] hover:text-[var(--color-text)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] [&::-webkit-details-marker]:hidden"
          aria-label="Toggle navigation menu"
        >
          <!-- Hamburger icon (visible when closed) -->
          <svg
            class="hamburger-open"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
          <!-- Close icon (visible when open) -->
          <svg
            class="hamburger-close hidden"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18" />
            <line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </summary>

        <!-- Mobile dropdown menu -->
        <div
          class="absolute right-0 top-14 w-56 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-3 shadow-lg backdrop-blur-xl backdrop-saturate-130"
        >
          <ul class="flex flex-col gap-1" role="list">
            <li>
              <a
                href="#features"
                class="mobile-nav-link block rounded-lg px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:bg-[var(--color-surface-light)] hover:text-[var(--color-text)]"
              >
                Features
              </a>
            </li>
            <li>
              <a
                href="#details"
                class="mobile-nav-link block rounded-lg px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:bg-[var(--color-surface-light)] hover:text-[var(--color-text)]"
              >
                Details
              </a>
            </li>
            <li>
              <a
                href="#footer-cta"
                class="mobile-nav-link block rounded-lg px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:bg-[var(--color-surface-light)] hover:text-[var(--color-text)]"
              >
                Open Source
              </a>
            </li>
          </ul>

          <!-- External links -->
          <div class="mt-2 flex flex-col gap-1 border-t border-[var(--color-border)] pt-2">
            <a
              href={gitlabUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitLab"
              title="GitLab Repository"
              class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:bg-[var(--color-surface-light)] hover:text-[var(--color-primary)]"
            >
              <svg width="20" height="20" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16 30.4L21.3 14.1H10.7L16 30.4Z"/><path d="M16 30.4L10.7 14.1H2.4L16 30.4Z" opacity="0.7"/><path d="M2.4 14.1L0.5 20.1C0.3 20.7 0.5 21.4 1 21.8L16 30.4L2.4 14.1Z" opacity="0.5"/><path d="M2.4 14.1H10.7L7.4 3.9C7.2 3.3 6.4 3.3 6.2 3.9L2.4 14.1Z"/><path d="M16 30.4L21.3 14.1H29.6L16 30.4Z" opacity="0.7"/><path d="M29.6 14.1L31.5 20.1C31.7 20.7 31.5 21.4 31 21.8L16 30.4L29.6 14.1Z" opacity="0.5"/><path d="M29.6 14.1H21.3L24.6 3.9C24.8 3.3 25.6 3.3 25.8 3.9L29.6 14.1Z"/></svg>
              GitLab
            </a>
            <a
              href={hiveBridgeUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Hive Bridge"
              title="Hive Bridge (Auth)"
              class="flex items-center gap-3 rounded-lg px-4 py-3 text-sm font-medium text-[var(--color-text-muted)] transition-colors duration-150 ease-out hover:bg-[var(--color-surface-light)] hover:text-[var(--color-primary)]"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 220 190"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path d="M157.272625,107.263942 C157.998992,107.263942 158.45262,108.051463 158.088736,108.68075 L111.33839,189.528945 C111.169808,189.820485 110.858795,190 110.522279,190 L81.9443812,190 C81.2180145,190 80.764386,189.212478 81.1282705,188.583191 L127.878616,107.734996 C128.047199,107.443456 128.358211,107.263942 128.694727,107.263942 L157.272625,107.263942 Z M129.477721,84.0901367 C129.141205,84.0901367 128.830192,83.9106218 128.66161,83.6190818 L81.1282705,1.41680884 C80.764386,0.787521511 81.2180145,0 81.9443812,0 L110.522279,0 C110.858795,0 111.169808,0.179514873 111.33839,0.471054898 L158.87173,82.6733278 C159.235614,83.3026152 158.781986,84.0901367 158.055619,84.0901367 L129.477721,84.0901367 Z" />
                <path d="M135.128406 1.41635199C134.76385.787064228 135.218932 0 135.947343 0L164.565951 0C164.903712 0 165.215845.179714185 165.384888.47151174L219.873006 94.5275799C220.042331 94.8198642 220.042331 95.1801358 219.873006 95.4724201L165.384888 189.528488C165.215845 189.820286 164.903712 190 164.565951 190L135.947343 190C135.218932 190 134.76385 189.212936 135.128406 188.583648L189.342845 95 135.128406 1.41635199zM111.870216 94.5240823C112.042446 94.816752 112.043313 95.1785591 111.872487 95.4720377L57.1252257 189.528106C56.7599958 190.155572 55.8478414 190.157723 55.4796094 189.531986L.129783614 95.4759177C-.0424457704 95.183248-.0433125021 94.8214409.127512727 94.5279623L54.8747743.471894257C55.2400042-.15557243 56.1521586-.157723129 56.5203906.468014185L111.870216 94.5240823z" />
              </svg>
              Hive Bridge
            </a>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<style>
  /* Toggle hamburger/close icons when details is open */
  details[open] .hamburger-open {
    display: none;
  }
  details[open] .hamburger-close {
    display: block;
  }

  /* Close mobile menu when a nav link is clicked */
  /* This relies on the details element losing focus */
</style>

<script>
  // Close mobile menu when a nav link is clicked
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      const details = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
      if (details) details.open = false;
    });
  });

  // Close mobile menu on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const details = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
      if (details?.open) {
        details.open = false;
        const summary = details.querySelector('summary');
        summary?.focus();
      }
    }
  });
</script>
