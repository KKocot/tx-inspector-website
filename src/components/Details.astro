---
/**
 * Details — Merged section combining Supported Formats and Authority Types.
 *
 * Two sub-blocks:
 * 1. Supported Formats (from former Formats.astro)
 * 2. Authority Types (from former AuthorityTypes.astro)
 */

import SectionHeader from "./SectionHeader.astro";
import GlassCard from "./GlassCard.astro";
import Badge from "./Badge.astro";

const authorities = [
  {
    name: "Posting",
    color: "#0fbd86",
    colorAlpha: "rgba(15, 189, 134, 0.1)",
    badgeVariant: "posting" as const,
    tagText: "Most Common",
    description:
      "Social operations — voting, commenting, posting. The most commonly used authority level.",
    examples: ["Post / comment", "Upvote / downvote", "Reblog"],
    delay: 0,
  },
  {
    name: "Active",
    color: "#0fbabd",
    colorAlpha: "rgba(15, 186, 189, 0.1)",
    badgeVariant: "active" as const,
    tagText: "Financial",
    description:
      "Financial operations — transfers, market orders, witness voting. Controls your wallet.",
    examples: ["Transfers", "Power up / down", "Witness votes"],
    delay: 100,
  },
  {
    name: "Owner",
    color: "#bd740f",
    colorAlpha: "rgba(189, 116, 15, 0.1)",
    badgeVariant: "owner" as const,
    tagText: "Highest Level",
    description:
      "Account recovery and authority changes. The highest level — use with extreme caution.",
    examples: ["Change keys", "Account recovery"],
    delay: 200,
  },
];
---

<section
  id="details"
  class="relative py-16 md:py-20 lg:py-24"
  aria-labelledby="details-heading"
>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-6 md:px-8">
    <SectionHeader
      badge="DETAILS"
      title="Formats & authority levels"
      description="Transaction Inspector handles every input format and verifies against HIVE's three-tier authority system."
      id="details-heading"
    />

    <!-- Sub-block 1: Supported Formats -->
    <div class="mb-16 md:mb-20">
      <h3
        class="animate-on-scroll mb-8 text-center text-lg font-semibold tracking-[-0.01em] text-text-muted uppercase tracking-widest sm:text-xl"
        data-animate="fade-up"
        data-delay="0"
      >
        Supported Formats
      </h3>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">

        <!-- JSON Transaction -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="0"
        >
          <GlassCard class="format-card">
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg
                  class="h-6 w-6 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1" />
                  <path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1" />
                </svg>
                <h4 class="text-lg font-semibold text-text">JSON Transaction</h4>
              </div>
              <Badge text="JSON" variant="neutral" />
            </div>

            <pre
              class="code-block overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-code)] p-4 md:p-5"
              aria-label="Example JSON transaction"
            ><code class="font-mono text-xs leading-relaxed"><span class="token-bracket">{"{"}</span>
  <span class="token-key">"ref_block_num"</span>: <span class="token-number">1234</span>,
  <span class="token-key">"operations"</span>: <span class="token-bracket">[</span>
    <span class="token-bracket">[</span><span class="token-string">"transfer"</span>, <span class="token-bracket">{"{"}</span>
      <span class="token-key">"from"</span>: <span class="token-string">"alice"</span>,
      <span class="token-key">"to"</span>: <span class="token-string">"bob"</span>
    <span class="token-bracket">{"}"}</span><span class="token-bracket">]</span>
  <span class="token-bracket">]</span>
<span class="token-bracket">{"}"}</span></code></pre>
          </GlassCard>
        </div>

        <!-- Transaction Hash -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="80"
        >
          <GlassCard class="format-card">
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg
                  class="h-6 w-6 text-secondary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="4" x2="20" y1="9" y2="9" />
                  <line x1="4" x2="20" y1="15" y2="15" />
                  <line x1="10" x2="8" y1="3" y2="21" />
                  <line x1="16" x2="14" y1="3" y2="21" />
                </svg>
                <h4 class="text-lg font-semibold text-text">Transaction Hash</h4>
              </div>
              <Badge text="HASH / ID" variant="neutral" />
            </div>

            <pre
              class="code-block overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-code)] p-4 md:p-5"
              aria-label="Example transaction hash"
            ><code class="font-mono text-sm leading-relaxed text-text-muted">abc123def456...789</code></pre>

            <p class="mt-4 text-sm leading-relaxed text-text-muted">
              Paste any transaction ID — the inspector fetches it directly from the HIVE blockchain.
            </p>
          </GlassCard>
        </div>

        <!-- Binary / Hex -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="160"
        >
          <GlassCard class="format-card">
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg
                  class="h-6 w-6 text-accent"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="14" y="14" width="4" height="6" rx="2" />
                  <rect x="6" y="4" width="4" height="6" rx="2" />
                  <path d="M6 20h4" />
                  <path d="M14 10h4" />
                  <path d="M6 14h2v6" />
                  <path d="M14 4h2v6" />
                </svg>
                <h4 class="text-lg font-semibold text-text">Binary & Hexadecimal</h4>
              </div>
              <Badge text="HEX / BINARY" variant="neutral" />
            </div>

            <pre
              class="code-block overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-code)] p-4 md:p-5"
              aria-label="Example hexadecimal transaction"
            ><code class="font-mono text-sm leading-relaxed text-text-muted">0x1f8b0800000000000003...</code></pre>

            <p class="mt-4 text-sm leading-relaxed text-text-muted">
              Raw binary or hex-encoded transactions are decoded automatically.
            </p>
          </GlassCard>
        </div>

        <!-- File Upload -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="240"
        >
          <GlassCard class="format-card">
            <div class="mb-4 flex items-center justify-between">
              <div class="flex items-center gap-3">
                <svg
                  class="h-6 w-6 text-primary"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" x2="12" y1="3" y2="15" />
                </svg>
                <h4 class="text-lg font-semibold text-text">File Upload</h4>
              </div>
              <Badge text="FILE UPLOAD" variant="neutral" />
            </div>

            <div class="flex flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-[var(--color-border-hover)] bg-[var(--color-surface-code)] px-6 py-8">
              <svg
                class="h-8 w-8 text-text-dim"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" x2="12" y1="3" y2="15" />
              </svg>
              <span class="text-sm text-text-muted">Drop your file here</span>
              <span class="text-xs font-medium tracking-wide text-text-dim">.json, .bin, or .hex</span>
            </div>

            <p class="mt-4 text-sm leading-relaxed text-text-muted">
              Upload JSON, binary, or hex files. Auto-detection of format included.
            </p>
          </GlassCard>
        </div>
      </div>
    </div>

    <!-- Sub-block 2: Authority Types -->
    <div>
      <h3
        class="animate-on-scroll mb-8 text-center text-lg font-semibold tracking-[-0.01em] text-text-muted uppercase tracking-widest sm:text-xl"
        data-animate="fade-up"
        data-delay="0"
      >
        Authority Types
      </h3>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
        {authorities.map((auth) => (
          <div
            class="animate-on-scroll"
            data-animate="fade-left"
            data-delay={String(auth.delay)}
          >
            <GlassCard
              class={`authority-card h-full border-l-[3px]`}
              style={`border-left-color: ${auth.color};`}
            >
              <!-- Icon container -->
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg"
                style={`background: ${auth.colorAlpha};`}
              >
                {auth.name === "Posting" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    style={`color: ${auth.color};`}
                  >
                    <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" />
                    <path d="m15 5 4 4" />
                  </svg>
                )}
                {auth.name === "Active" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    style={`color: ${auth.color};`}
                  >
                    <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" />
                  </svg>
                )}
                {auth.name === "Owner" && (
                  <svg
                    class="h-5 w-5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    style={`color: ${auth.color};`}
                  >
                    <path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z" />
                    <path d="M5 21h14" />
                  </svg>
                )}
              </div>

              <!-- Badge -->
              <div class="mt-4">
                <Badge text={auth.tagText} variant={auth.badgeVariant} />
              </div>

              <!-- Title -->
              <h4 class="mt-3 text-lg font-semibold tracking-[-0.01em] text-text lg:text-2xl">
                {auth.name} Authority
              </h4>

              <!-- Description -->
              <p class="mt-2 text-sm leading-relaxed text-text-muted lg:text-base">
                {auth.description}
              </p>

              <!-- Examples pills -->
              <div class="mt-4 flex flex-wrap gap-2">
                {auth.examples.map((example) => (
                  <span class="rounded-full bg-surface-light px-3 py-1 text-xs font-medium text-text-dim lg:text-sm">
                    {example}
                  </span>
                ))}
              </div>
            </GlassCard>
          </div>
        ))}
      </div>

      <!-- Note below cards -->
      <p
        class="animate-on-scroll mx-auto mt-8 max-w-[720px] text-center text-sm leading-relaxed text-text-dim md:mt-10"
        data-animate="fade-up"
        data-delay="300"
      >
        The Transaction Inspector automatically detects which authority level each operation requires and verifies the corresponding signatures.
      </p>
    </div>
  </div>
</section>

<style>
  /* Code block base styling */
  .code-block {
    -webkit-overflow-scrolling: touch;
  }

  /* Format cards — no translateY hover on code cards */
  .format-card:hover {
    transform: none;
  }

  /* Authority card — border-left glow on hover */
  .authority-card {
    transition:
      border-color 250ms ease-out,
      box-shadow 250ms ease-out;
  }

  .authority-card:hover {
    transform: none;
  }

  /* fade-left animation keyframe */
  @keyframes scroll-fade-left {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  :global(.animate-on-scroll[data-animate="fade-left"]) {
    opacity: 0;
    transform: translateX(-12px);
  }

  :global(.animate-on-scroll[data-animate="fade-left"].is-visible) {
    animation: scroll-fade-left 500ms ease-out forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-on-scroll[data-animate="fade-left"]) {
      opacity: 1;
      transform: none;
    }

    :global(.animate-on-scroll[data-animate="fade-left"].is-visible) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
