---
/**
 * Details — Merged section combining Supported Formats and Authority Types.
 *
 * Two sub-blocks:
 * 1. Supported Formats (from former Formats.astro)
 * 2. Authority Types (from former AuthorityTypes.astro)
 */

import Badge from "./Badge.astro";

const authorities = [
  {
    name: "Posting",
    color: "#0fbd86",
    badgeVariant: "posting" as const,
    tagText: "Most Common",
    description:
      "Social operations — voting, commenting, posting. The most commonly used authority level.",
    examples: ["Post / comment", "Upvote / downvote", "Reblog"],
    delay: 0,
  },
  {
    name: "Active",
    color: "#0fbabd",
    badgeVariant: "active" as const,
    tagText: "Financial",
    description:
      "Financial operations — transfers, market orders, witness voting. Controls your wallet.",
    examples: ["Transfers", "Power up / down", "Witness votes"],
    delay: 100,
  },
  {
    name: "Owner",
    color: "#bd740f",
    badgeVariant: "owner" as const,
    tagText: "Highest Level",
    description:
      "Account recovery and authority changes. The highest level — use with extreme caution.",
    examples: ["Change keys", "Account recovery"],
    delay: 200,
  },
];
---

<section
  id="details"
  class="relative min-h-screen flex flex-col items-center justify-center py-16 md:py-20 lg:py-24"
  aria-labelledby="details-heading"
>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-6 md:px-8">
    <div class="mb-12 lg:mb-16">
      <h2
        id="details-heading"
        class="animate-on-scroll mt-3 text-[1.75rem] font-bold leading-[1.2] tracking-[-0.02em] text-text sm:text-[2rem] lg:text-[2.5rem]"
        data-animate="fade-up"
        data-delay="50"
      >
        Formats & authority levels
      </h2>

      <p
        class="animate-on-scroll mt-4 max-w-[640px] text-base leading-relaxed text-text-muted lg:text-xl"
        data-animate="fade-up"
        data-delay="100"
      >
        Transaction Inspector handles every input format and verifies against HIVE's three-tier authority system.
      </p>
    </div>

    <!-- Sub-block 1: Supported Formats -->
    <div class="mb-16 md:mb-20">
      <h3
        class="animate-on-scroll mb-8 text-lg font-semibold text-text-muted uppercase tracking-widest sm:text-xl"
        data-animate="fade-up"
        data-delay="0"
      >
        Supported Formats
      </h3>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8">

        <!-- JSON Transaction -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="0"
        >
          <div class="format-item relative flex flex-col pb-6 border-b border-[var(--color-border)] md:min-h-[280px]">
            <span class="absolute top-0 right-0"><Badge text="JSON" variant="neutral" /></span>
            <div class="mb-4 flex items-center gap-3 pr-20">
              <svg
                class="h-6 w-6 text-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M8 3H7a2 2 0 0 0-2 2v5a2 2 0 0 1-2 2 2 2 0 0 1 2 2v5a2 2 0 0 0 2 2h1" />
                <path d="M16 3h1a2 2 0 0 1 2 2v5a2 2 0 0 0 2 2 2 2 0 0 0-2 2v5a2 2 0 0 1-2 2h-1" />
              </svg>
              <h4 class="text-lg font-semibold text-text">JSON Transaction</h4>
            </div>

            <div class="mt-auto">
            <pre
              class="code-block overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-code)] p-4 md:p-5 md:min-h-[120px]"
              aria-label="Example JSON transaction"
            ><code class="font-mono text-xs leading-relaxed"><span class="token-bracket">{"{"}</span>
  <span class="token-key">"ref_block_num"</span>: <span class="token-number">1234</span>,
  <span class="token-key">"operations"</span>: <span class="token-bracket">[</span>
    <span class="token-bracket">[</span><span class="token-string">"transfer"</span>, <span class="token-bracket">{"{"}</span>
      <span class="token-key">"from"</span>: <span class="token-string">"alice"</span>,
      <span class="token-key">"to"</span>: <span class="token-string">"bob"</span>
    <span class="token-bracket">{"}"}</span><span class="token-bracket">]</span>
  <span class="token-bracket">]</span>
<span class="token-bracket">{"}"}</span></code></pre>
            </div>
          </div>
        </div>

        <!-- Transaction Hash -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="80"
        >
          <div class="format-item relative flex flex-col pb-6 border-b border-[var(--color-border)] md:min-h-[280px]">
            <span class="absolute top-0 right-0"><Badge text="HASH / ID" variant="neutral" /></span>
            <div class="mb-4 flex items-center gap-3 pr-24">
              <svg
                class="h-6 w-6 text-secondary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="4" x2="20" y1="9" y2="9" />
                <line x1="4" x2="20" y1="15" y2="15" />
                <line x1="10" x2="8" y1="3" y2="21" />
                <line x1="16" x2="14" y1="3" y2="21" />
              </svg>
              <h4 class="text-lg font-semibold text-text">Transaction Hash</h4>
            </div>

            <div class="mt-auto">
              <pre
                class="code-block overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-code)] p-4 md:p-5 md:min-h-[120px]"
                aria-label="Example transaction hash"
              ><code class="font-mono text-sm leading-relaxed text-text-muted">abc123def456...789</code></pre>

              <p class="mt-4 text-sm leading-relaxed text-text-muted">
                Paste any transaction ID — the inspector fetches it directly from the HIVE blockchain.
              </p>
            </div>
          </div>
        </div>

        <!-- Binary / Hex -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="160"
        >
          <div class="format-item relative flex flex-col pb-6 border-b border-[var(--color-border)] md:border-b-0 md:min-h-[280px]">
            <span class="absolute top-0 right-0"><Badge text="HEX / BINARY" variant="neutral" /></span>
            <div class="mb-4 flex items-center gap-3 pr-28">
              <svg
                class="h-6 w-6 text-accent"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="14" y="14" width="4" height="6" rx="2" />
                <rect x="6" y="4" width="4" height="6" rx="2" />
                <path d="M6 20h4" />
                <path d="M14 10h4" />
                <path d="M6 14h2v6" />
                <path d="M14 4h2v6" />
              </svg>
              <h4 class="text-lg font-semibold text-text">Binary & Hexadecimal</h4>
            </div>

            <div class="mt-auto">
              <pre
                class="code-block overflow-x-auto rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-code)] p-4 md:p-5 md:min-h-[120px]"
                aria-label="Example hexadecimal transaction"
              ><code class="font-mono text-sm leading-relaxed text-text-muted">0x1f8b0800000000000003...</code></pre>

              <p class="mt-4 text-sm leading-relaxed text-text-muted">
                Raw binary or hex-encoded transactions are decoded automatically.
              </p>
            </div>
          </div>
        </div>

        <!-- File Upload -->
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay="240"
        >
          <div class="format-item relative flex flex-col pb-6 md:pb-0 md:min-h-[280px]">
            <span class="absolute top-0 right-0"><Badge text="FILE UPLOAD" variant="neutral" /></span>
            <div class="mb-4 flex items-center gap-3 pr-28">
              <svg
                class="h-6 w-6 text-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" x2="12" y1="3" y2="15" />
              </svg>
              <h4 class="text-lg font-semibold text-text">File Upload</h4>
            </div>

            <div class="mt-auto">
              <div class="flex flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-[var(--color-border-hover)] bg-[var(--color-surface-code)] px-6 py-8 md:min-h-[120px]">
                <svg
                  class="h-8 w-8 text-text-dim"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="17 8 12 3 7 8" />
                  <line x1="12" x2="12" y1="3" y2="15" />
                </svg>
                <span class="text-sm text-text-muted">Drop your file here</span>
                <span class="text-xs font-medium tracking-wide text-text-dim">.json, .bin, or .hex</span>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-text-muted">
                Upload JSON, binary, or hex files. Auto-detection of format included.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sub-block 2: Authority Types -->
    <div>
      <h3
        class="animate-on-scroll mb-8 text-center text-lg font-semibold text-text-muted uppercase tracking-widest sm:text-xl"
        data-animate="fade-up"
        data-delay="0"
      >
        Authority Types
      </h3>

      <dl class="authority-list" role="list">
        {authorities.map((auth) => (
          <div
            class="animate-on-scroll authority-row border-b border-[#262626] py-5 px-4"
            style={`border-left: 3px solid ${auth.color};`}
            data-animate="fade-left"
            data-delay={String(auth.delay)}
            role="listitem"
          >
            <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-6">
              <!-- Name + Badge -->
              <div class="md:w-[200px] md:shrink-0">
                <dt
                  class="font-mono text-base font-bold"
                  style={`color: ${auth.color};`}
                >
                  {auth.name}
                </dt>
                <div class="mt-1">
                  <Badge text={auth.tagText} variant={auth.badgeVariant} />
                </div>
              </div>

              <!-- Description -->
              <dd class="text-sm leading-relaxed text-text-muted md:flex-1">
                {auth.description}
              </dd>

              <!-- Example pills -->
              <div class="flex flex-wrap gap-2 md:shrink-0">
                {auth.examples.map((example) => (
                  <span class="rounded-full bg-surface-light px-3 py-1 text-xs font-medium text-text-dim">
                    {example}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </dl>

      <!-- Note below -->
      <p
        class="animate-on-scroll mx-auto mt-8 max-w-[720px] text-center text-sm leading-relaxed text-text-dim md:mt-10"
        data-animate="fade-up"
        data-delay="300"
      >
        The Transaction Inspector automatically detects which authority level each operation requires and verifies the corresponding signatures.
      </p>
    </div>
  </div>
</section>

<style>
  /* Code block base styling */
  .code-block {
    -webkit-overflow-scrolling: touch;
  }

  /* Authority row — subtle hover */
  .authority-row {
    transition: background-color 200ms ease-out;
  }

  .authority-row:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .authority-row:last-child {
    border-bottom: none;
  }

  /* fade-left animation keyframe */
  @keyframes scroll-fade-left {
    from {
      opacity: 0;
      transform: translateX(-12px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  :global(.animate-on-scroll[data-animate="fade-left"]) {
    opacity: 0;
    transform: translateX(-12px);
  }

  :global(.animate-on-scroll[data-animate="fade-left"].is-visible) {
    animation: scroll-fade-left 500ms ease-out forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-on-scroll[data-animate="fade-left"]) {
      opacity: 1;
      transform: none;
    }

    :global(.animate-on-scroll[data-animate="fade-left"].is-visible) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
