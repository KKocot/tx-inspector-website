<canvas id="hex-bg" aria-hidden="true"></canvas>

<style>
  #hex-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById("hex-bg") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  const HEX_RADIUS = 35;
  const HEX_GAP = 4;
  const COLOR = [15, 186, 189] as const;
  const MIN_ALPHA = 0.02;
  const MAX_ALPHA = 0.04;
  const FADE_START = 0.65;

  const hexHeight = HEX_RADIUS * 2;
  const hexWidth = Math.sqrt(3) * HEX_RADIUS;
  const colStep = hexWidth + HEX_GAP;
  const rowStep = hexHeight * 0.75 + HEX_GAP;

  let dpr = 1;
  let cols = 0;
  let rows = 0;
  let hexagons: { cx: number; cy: number; phase: number }[] = [];

  function resize() {
    dpr = window.devicePixelRatio || 1;
    canvas.width = window.innerWidth * dpr;
    canvas.height = window.innerHeight * dpr;
    canvas.style.width = `${window.innerWidth}px`;
    canvas.style.height = `${window.innerHeight}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    cols = Math.ceil(window.innerWidth / colStep) + 2;
    rows = Math.ceil(window.innerHeight / rowStep) + 2;

    hexagons = [];
    for (let row = 0; row < rows; row++) {
      const offset = row % 2 === 1 ? colStep / 2 : 0;
      for (let col = 0; col < cols; col++) {
        hexagons.push({
          cx: col * colStep + offset - colStep / 2,
          cy: row * rowStep - rowStep / 2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }
  }

  function drawHexPath(cx: number, cy: number) {
    ctx.beginPath();
    for (let i = 0; i < 6; i++) {
      const angle = (Math.PI / 3) * i - Math.PI / 6;
      const x = cx + HEX_RADIUS * Math.cos(angle);
      const y = cy + HEX_RADIUS * Math.sin(angle);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    }
    ctx.closePath();
  }

  function fadeFactor(cy: number, viewH: number): number {
    const ratio = cy / viewH;
    if (ratio < FADE_START) return 1;
    return Math.max(0, 1 - (ratio - FADE_START) / (1 - FADE_START));
  }

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  function drawStatic() {
    resize();
    const viewH = window.innerHeight;
    ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
    ctx.lineWidth = 1;

    for (const hex of hexagons) {
      const fade = fadeFactor(hex.cy, viewH);
      const alpha = ((MIN_ALPHA + MAX_ALPHA) / 2) * fade;
      if (alpha < 0.001) continue;
      ctx.strokeStyle = `rgba(${COLOR[0]},${COLOR[1]},${COLOR[2]},${alpha})`;
      drawHexPath(hex.cx, hex.cy);
      ctx.stroke();
    }
  }

  if (prefersReducedMotion) {
    drawStatic();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(drawStatic, 200);
    });
  } else {
    resize();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 150);
    });

    let animId: number;
    function animate(time: number) {
      const viewH = window.innerHeight;
      ctx.clearRect(0, 0, canvas.width / dpr, canvas.height / dpr);
      ctx.lineWidth = 1;

      const t = time * 0.001;

      for (const hex of hexagons) {
        const fade = fadeFactor(hex.cy, viewH);
        const wave = Math.sin(t * 0.6 + hex.phase + hex.cx * 0.003 + hex.cy * 0.005);
        const alpha = (MIN_ALPHA + (MAX_ALPHA - MIN_ALPHA) * (wave * 0.5 + 0.5)) * fade;
        if (alpha < 0.001) continue;
        ctx.strokeStyle = `rgba(${COLOR[0]},${COLOR[1]},${COLOR[2]},${alpha})`;
        drawHexPath(hex.cx, hex.cy);
        ctx.stroke();
      }

      animId = requestAnimationFrame(animate);
    }

    animId = requestAnimationFrame(animate);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        cancelAnimationFrame(animId);
      } else {
        animId = requestAnimationFrame(animate);
      }
    });
  }
</script>
