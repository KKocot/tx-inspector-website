---
/**
 * HeroVisual — stylized mockup of the Transaction Inspector interface.
 * Pure CSS/HTML art — no screenshots, no external images.
 *
 * Structure:
 *   - macOS-style toolbar with traffic lights + tab
 *   - JSON code block with syntax highlighting
 *   - Status bar with authority badges
 *   - Glow effect behind the card
 */
---

<div class="hero-visual relative mx-auto w-full max-w-[900px]">
  <!-- Glow behind card -->
  <div
    class="absolute -inset-8 rounded-3xl opacity-60 blur-3xl pointer-events-none"
    style="background: radial-gradient(ellipse 70% 50% at 50% 40%, rgba(15,186,189,0.15) 0%, rgba(15,189,134,0.06) 50%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <!-- Main card -->
  <div
    class="hero-visual__card relative overflow-hidden rounded-2xl border border-border bg-[rgba(10,10,10,0.6)] shadow-[0_0_0_1px_var(--color-border),0_1px_2px_rgba(0,0,0,0.4),0_0_30px_rgba(15,186,189,0.2),0_0_60px_rgba(15,186,189,0.05)]"
    style="backdrop-filter: blur(16px) saturate(130%);"
  >
    <!-- Toolbar -->
    <div class="flex items-center gap-3 border-b border-border px-4 py-3">
      <!-- Traffic lights -->
      <div class="flex items-center gap-1.5" aria-hidden="true">
        <span class="block h-3 w-3 rounded-full bg-[#ff5f57]"></span>
        <span class="block h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
        <span class="block h-3 w-3 rounded-full bg-[#28c840]"></span>
      </div>
      <!-- Tab -->
      <div class="ml-2 flex items-center gap-2 rounded-md bg-surface px-3 py-1">
        <svg
          class="h-3.5 w-3.5 text-[#71717a]"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
        </svg>
        <span class="font-mono text-xs text-[#71717a]">transaction.json</span>
      </div>
    </div>

    <!-- Code block -->
    <div class="px-5 py-5 sm:px-6 sm:py-6">
      <pre
        class="overflow-x-auto font-mono text-xs leading-relaxed sm:text-sm"
        aria-label="Example JSON transaction"
      ><code class="hero-code"><span class="code-line"><span class="token-bracket">{</span></span>
<span class="code-line">  <span class="token-key">"ref_block_num"</span><span class="token-bracket">:</span> <span class="token-number">78432</span><span class="token-bracket">,</span></span>
<span class="code-line">  <span class="token-key">"ref_block_prefix"</span><span class="token-bracket">:</span> <span class="token-number">2981674523</span><span class="token-bracket">,</span></span>
<span class="code-line">  <span class="token-key">"expiration"</span><span class="token-bracket">:</span> <span class="token-string">"2024-01-15T12:30:00"</span><span class="token-bracket">,</span></span>
<span class="code-line">  <span class="token-key">"operations"</span><span class="token-bracket">:</span> <span class="token-bracket">[</span></span>
<span class="code-line">    <span class="token-bracket">{</span></span>
<span class="code-line">      <span class="token-key">"type"</span><span class="token-bracket">:</span> <span class="token-string">"transfer_operation"</span><span class="token-bracket">,</span></span>
<span class="code-line">      <span class="token-key">"value"</span><span class="token-bracket">:</span> <span class="token-bracket">{</span></span>
<span class="code-line">        <span class="token-key">"from"</span><span class="token-bracket">:</span> <span class="token-string">"alice"</span><span class="token-bracket">,</span></span>
<span class="code-line">        <span class="token-key">"to"</span><span class="token-bracket">:</span> <span class="token-string">"bob"</span><span class="token-bracket">,</span></span>
<span class="code-line">        <span class="token-key">"amount"</span><span class="token-bracket">:</span> <span class="token-string">"10.000 HIVE"</span><span class="token-bracket">,</span></span>
<span class="code-line">        <span class="token-key">"memo"</span><span class="token-bracket">:</span> <span class="token-string">"Payment for services"</span></span>
<span class="code-line">      <span class="token-bracket">}</span></span>
<span class="code-line">    <span class="token-bracket">}</span></span>
<span class="code-line">  <span class="token-bracket">]</span></span>
<span class="code-line"><span class="token-bracket">}</span></span></code></pre>
    </div>

    <!-- Status bar -->
    <div class="flex flex-wrap items-center gap-2 border-t border-border px-5 py-3 sm:px-6">
      <!-- Signature Valid badge -->
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-[rgba(15,189,134,0.3)] bg-[rgba(15,189,134,0.1)] px-2.5 py-0.5 text-xs font-medium text-secondary"
      >
        <svg
          class="h-3 w-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        Signature Valid
      </span>

      <!-- Active Authority badge -->
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-[rgba(15,186,189,0.3)] bg-[rgba(15,186,189,0.1)] px-2.5 py-0.5 text-xs font-medium text-primary"
      >
        <svg
          class="h-3 w-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="m21 2-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4"
          ></path>
        </svg>
        Active Authority
      </span>

      <!-- 2 Operations badge -->
      <span
        class="inline-flex items-center gap-1.5 rounded-full border border-border bg-white/5 px-2.5 py-0.5 text-xs font-medium text-text-muted"
      >
        <svg
          class="h-3 w-3"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"
          ></path>
          <path d="m2 12 8.58 3.91a2 2 0 0 0 1.66 0L21 12"></path>
        </svg>
        2 Operations
      </span>

      <!-- Spacer + mini authority graph on larger screens -->
      <div class="ml-auto hidden items-center gap-3 sm:flex" aria-hidden="true">
        <!-- Simplified mini authority graph: 3 nodes with connecting lines -->
        <svg class="h-6 w-28" viewBox="0 0 112 24" fill="none">
          <!-- Connecting lines -->
          <line x1="16" y1="12" x2="46" y2="12" stroke="#262626" stroke-width="1" stroke-dasharray="3 2"></line>
          <line x1="66" y1="12" x2="96" y2="12" stroke="#262626" stroke-width="1" stroke-dasharray="3 2"></line>
          <!-- Posting node -->
          <circle cx="12" cy="12" r="5" fill="rgba(15,189,134,0.2)" stroke="#0fbd86" stroke-width="1.5"></circle>
          <!-- Active node -->
          <circle cx="56" cy="12" r="5" fill="rgba(15,186,189,0.2)" stroke="#0fbabd" stroke-width="1.5"></circle>
          <!-- Owner node -->
          <circle cx="100" cy="12" r="5" fill="rgba(189,116,15,0.2)" stroke="#bd740f" stroke-width="1.5"></circle>
        </svg>
      </div>
    </div>
  </div>
</div>

<style>
  /* Code line typing animation — sequential fade-in */
  .code-line {
    display: block;
    opacity: 0;
    animation: code-line-in 300ms ease-out forwards;
  }

  .code-line:nth-child(1) { animation-delay: 600ms; }
  .code-line:nth-child(2) { animation-delay: 680ms; }
  .code-line:nth-child(3) { animation-delay: 760ms; }
  .code-line:nth-child(4) { animation-delay: 840ms; }
  .code-line:nth-child(5) { animation-delay: 920ms; }
  .code-line:nth-child(6) { animation-delay: 1000ms; }
  .code-line:nth-child(7) { animation-delay: 1080ms; }
  .code-line:nth-child(8) { animation-delay: 1160ms; }
  .code-line:nth-child(9) { animation-delay: 1240ms; }
  .code-line:nth-child(10) { animation-delay: 1320ms; }
  .code-line:nth-child(11) { animation-delay: 1400ms; }
  .code-line:nth-child(12) { animation-delay: 1480ms; }
  .code-line:nth-child(13) { animation-delay: 1560ms; }
  .code-line:nth-child(14) { animation-delay: 1640ms; }
  .code-line:nth-child(15) { animation-delay: 1720ms; }
  .code-line:nth-child(16) { animation-delay: 1800ms; }

  @keyframes code-line-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Float animation for the entire visual */
  .hero-visual {
    animation: hero-float 6s ease-in-out infinite;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-8px); }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .code-line {
      opacity: 1;
      animation: none;
    }
    .hero-visual {
      animation: none;
    }
  }
</style>
