---
/**
 * FooterCTA — Single cohesive pre-footer section.
 *
 * One heading, tech badges, CTA button, trust note.
 * Keeps it minimal — MIT license info lives in the tmux footer bar.
 */

import Button from "./Button.astro";
import { GITLAB_URL } from "../config";

const techBadges = [
  { name: "Vue 3", delay: 0 },
  { name: "Nuxt 3", delay: 40 },
  { name: "TypeScript", delay: 80 },
  { name: "@hiveio/wax", delay: 120 },
  { name: "Tailwind CSS", delay: 160 },
  { name: "Pinia", delay: 200 },
];
---

<section
  id="footer-cta"
  class="footer-cta-section relative min-h-screen flex flex-col items-center justify-center py-16 md:py-20 lg:py-24"
  aria-labelledby="footer-cta-heading"
>
  <div class="footer-cta-glow" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-[720px] px-5 sm:px-6 md:px-8 text-center">
    <!-- Heading -->
    <h2
      id="footer-cta-heading"
      class="animate-on-scroll mt-4 text-[1.75rem] font-bold leading-[1.15] tracking-[-0.02em] text-text sm:text-[2.25rem] lg:text-[2.75rem]"
      data-animate="fade-up"
      data-delay="50"
    >
      Ready to inspect?
    </h2>

    <!-- Tech badges -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-1.5">
      {techBadges.map((badge) => (
        <span
          class="animate-on-scroll inline-flex items-center rounded border border-border bg-transparent px-3 py-1.5 font-mono text-xs text-text-muted transition-colors duration-200 ease-out hover:border-border-hover hover:text-text"
          data-animate="fade-in-scale"
          data-delay={String(badge.delay)}
        >
          [{badge.name}]
        </span>
      ))}
    </div>

    <!-- CTA -->
    <div
      class="animate-on-scroll mt-8 lg:mt-10"
      data-animate="fade-up"
      data-delay="120"
    >
      <Button
        href={GITLAB_URL}
        variant="ghost"
        size="lg"
        target="_blank"
        aria-label="View source code on GitLab (opens in new tab)"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m22 13.29-3.33-10a.42.42 0 0 0-.14-.18.38.38 0 0 0-.22-.11.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18l-2.26 6.67H8.32L6.1 3.26a.42.42 0 0 0-.1-.18.38.38 0 0 0-.26-.08.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18L2 13.29a.74.74 0 0 0 .27.83L12 21l9.69-6.88a.71.71 0 0 0 .31-.83Z" />
        </svg>
        View on GitLab
      </Button>
    </div>

    <!-- Trust note -->
    <p
      class="animate-on-scroll mt-6 text-sm text-text-dim"
      data-animate="fade-up"
      data-delay="180"
    >
      100% client-side &middot; No account required
    </p>
  </div>
</section>

<style>
  .footer-cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 50% at 50% 100%,
      rgba(15, 186, 189, 0.06) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  :global(.animate-on-scroll[data-animate="fade-in-scale"]) {
    opacity: 0;
    transform: scale(0.95);
  }

  :global(.animate-on-scroll[data-animate="fade-in-scale"].is-visible) {
    animation: scroll-fade-in-scale 300ms ease-out forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @keyframes scroll-fade-in-scale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-on-scroll[data-animate="fade-in-scale"]) {
      opacity: 1;
      transform: none;
    }

    :global(.animate-on-scroll[data-animate="fade-in-scale"].is-visible) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
