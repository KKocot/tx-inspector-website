---
/**
 * OpenSource -- OSS messaging, tech stack badges, and info cards.
 *
 * Design Brief 5.6:
 * - SectionHeader with "OPEN SOURCE" badge
 * - Flex-wrap tech badge row
 * - 3 info cards (grid md:3)
 * - "View Source on GitLab" ghost button
 *
 * Motion: tech badges use fade-in+scale stagger 40ms,
 *         info cards use staggered fade-up.
 */

import SectionHeader from "./SectionHeader.astro";
import GlassCard from "./GlassCard.astro";
import Button from "./Button.astro";
import { GITLAB_URL } from "../config";

const techBadges = [
  { name: "Vue 3", delay: 0 },
  { name: "Nuxt 3", delay: 40 },
  { name: "TypeScript", delay: 80 },
  { name: "@hiveio/wax", delay: 120 },
  { name: "Tailwind CSS", delay: 160 },
  { name: "Pinia", delay: 200 },
];

const infoCards = [
  {
    title: "100% Client-Side",
    description:
      "All analysis happens in your browser. No data sent to servers.",
    delay: 0,
  },
  {
    title: "MIT Licensed",
    description: "Free to use, modify, and distribute.",
    delay: 80,
  },
  {
    title: "Community Driven",
    description: "Built by and for the HIVE ecosystem.",
    delay: 160,
  },
];
---

<section
  id="open-source"
  class="relative py-16 md:py-20 lg:py-24"
  aria-labelledby="open-source-heading"
>
  <div class="mx-auto max-w-[1200px] px-5 sm:px-6 md:px-8">
    <SectionHeader
      badge="OPEN SOURCE"
      title="Built in the open"
      description="Transaction Inspector is fully open-source, built with modern web technologies, and designed for the HIVE community."
      id="open-source-heading"
    />

    <!-- Tech badges row -->
    <div class="mb-10 flex flex-wrap items-center justify-center gap-3 md:mb-12">
      {techBadges.map((badge) => (
        <span
          class="tech-badge animate-on-scroll inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-sm text-[var(--color-text-muted)] transition-all duration-200 ease-out hover:border-[var(--color-border-hover)] hover:text-[var(--color-text)]"
          data-animate="fade-in-scale"
          data-delay={String(badge.delay)}
        >
          {badge.name}
        </span>
      ))}
    </div>

    <!-- Info cards grid -->
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3 md:gap-6">
      {infoCards.map((card) => (
        <div
          class="animate-on-scroll"
          data-animate="fade-up"
          data-delay={String(card.delay)}
        >
          <GlassCard variant="feature" class="info-card h-full text-center">
            <!-- Icon -->
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-primary-subtle)]">
              {card.title === "100% Client-Side" && (
                <svg
                  class="h-6 w-6 text-[var(--color-primary)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="18" height="18" x="3" y="3" rx="2" />
                  <path d="M7 7h3v3H7z" />
                  <path d="M7 14h3v3H7z" />
                  <path d="M14 7h3v3h-3z" />
                  <path d="M14 14h3v3h-3z" />
                </svg>
              )}
              {card.title === "MIT Licensed" && (
                <svg
                  class="h-6 w-6 text-[var(--color-primary)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10" />
                  <path d="m9 12 2 2 4-4" />
                </svg>
              )}
              {card.title === "Community Driven" && (
                <svg
                  class="h-6 w-6 text-[var(--color-primary)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
              )}
            </div>

            <!-- Title -->
            <h3 class="text-lg font-semibold tracking-[-0.01em] text-text lg:text-xl">
              {card.title}
            </h3>

            <!-- Description -->
            <p class="mt-2 text-sm leading-relaxed text-text-muted">
              {card.description}
            </p>
          </GlassCard>
        </div>
      ))}
    </div>

    <!-- GitLab button -->
    <div
      class="animate-on-scroll mt-8 flex justify-center md:mt-10"
      data-animate="fade-up"
      data-delay="240"
    >
      <Button
        href={GITLAB_URL}
        variant="ghost"
        size="md"
        target="_blank"
        aria-label="View source code on GitLab (opens in new tab)"
      >
        <!-- GitLab icon -->
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m22 13.29-3.33-10a.42.42 0 0 0-.14-.18.38.38 0 0 0-.22-.11.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18l-2.26 6.67H8.32L6.1 3.26a.42.42 0 0 0-.1-.18.38.38 0 0 0-.26-.08.39.39 0 0 0-.23.07.42.42 0 0 0-.14.18L2 13.29a.74.74 0 0 0 .27.83L12 21l9.69-6.88a.71.71 0 0 0 .31-.83Z" />
        </svg>
        View Source on GitLab
      </Button>
    </div>
  </div>
</section>

<style>
  /* fade-in-scale animation for tech badges */
  :global(.animate-on-scroll[data-animate="fade-in-scale"]) {
    opacity: 0;
    transform: scale(0.95);
  }

  :global(.animate-on-scroll[data-animate="fade-in-scale"].is-visible) {
    animation: scroll-fade-in-scale 300ms ease-out forwards;
    animation-delay: var(--stagger-delay, 0ms);
  }

  @keyframes scroll-fade-in-scale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.animate-on-scroll[data-animate="fade-in-scale"]) {
      opacity: 1;
      transform: none;
    }

    :global(.animate-on-scroll[data-animate="fade-in-scale"].is-visible) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  /* Info card — disable translateY on hover (keep glow only) */
  .info-card:hover {
    transform: none;
  }
</style>
