---
import Badge from "./Badge.astro";

interface Props {
  badge?: string;
  title: string;
  description?: string;
  id?: string;
}

const { badge, title, description, id } = Astro.props;
---

<div class="section-header mx-auto mb-12 flex flex-col items-center text-center lg:mb-16">
  {badge && (
    <div class="animate-on-scroll mb-4" data-animate="fade-up" data-delay="0">
      <Badge text={badge} variant="neutral" />
    </div>
  )}

  <h2
    id={id}
    class="animate-on-scroll text-[1.75rem] font-bold leading-[1.2] tracking-[-0.02em] text-text sm:text-[2rem] lg:text-[2.5rem]"
    data-animate="fade-up"
    data-delay="50"
  >
    {title}
  </h2>

  {description && (
    <p
      class="animate-on-scroll mt-4 max-w-[640px] text-base leading-relaxed text-text-muted lg:text-xl"
      data-animate="fade-up"
      data-delay="100"
    >
      {description}
    </p>
  )}
</div>
